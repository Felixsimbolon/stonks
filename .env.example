# Copy to .env and fill in. Never commit .env.
# Write values without quotes or spaces around "=".

# --- Database ---------------------------------------------------------------
# Local SQLite file by default. For deploys, a libSQL/Turso URL + token.
DATABASE_URL=file:./data/stonks.db
DATABASE_AUTH_TOKEN=

# --- Sectors (the only data source) ------------------------------------------
# From https://sectors.app/api → API Keys. Sent raw in the Authorization header.
SECTORS_API_KEY=
SECTORS_API_BASE=https://api.sectors.app/v2
# Hard stop on billed (non-cached) Sectors calls.
SECTORS_CREDIT_LIMIT=1000

# --- Optional ---------------------------------------------------------------
# LLM narration + chat. The app works without it (no narrative, no chat).
ANTHROPIC_API_KEY=
# Alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
