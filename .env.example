# Copy to .env and fill in. Never commit .env.
# Write values without quotes or spaces around "=".

# --- Access -----------------------------------------------------------------
# Set on any public deployment: the app spends real API credits. Empty = no gate (local).
APP_PASSWORD=

# --- Database ---------------------------------------------------------------
# Local SQLite file by default. On Vercel, set these to the Turso URL + token.
DATABASE_URL=file:./data/stonks.db
DATABASE_AUTH_TOKEN=
# Turso target for npm run db:push:turso / db:copy-to-turso (local machine only).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Sectors (the only data source) ------------------------------------------
# From https://sectors.app/api → API Keys. Sent raw in the Authorization header.
SECTORS_API_KEY=
SECTORS_API_BASE=https://api.sectors.app/v2
# Hard stop on billed (non-cached) Sectors calls.
SECTORS_CREDIT_LIMIT=1000

# --- Optional ---------------------------------------------------------------
# AI summaries + Ask Stonks chat. The app works without it (no AI features).
ANTHROPIC_API_KEY=
# Claude model (default claude-opus-5-5; claude-sonnet-5-5 or claude-haiku-5-5 cost less).
LLM_MODEL=claude-opus-5-5
# Hard daily cap on Claude tokens (input + output) across summaries and chat.
LLM_DAILY_TOKEN_LIMIT=500000
# Alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
